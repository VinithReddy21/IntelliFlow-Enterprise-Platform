# ===================================================================
# IntelliFlow Platform — Unified Enterprise Environment Template
# ===================================================================

# Database Credentials (PostgreSQL / Neon)
POSTGRES_DB=intelliflow_prod_db
POSTGRES_USER=intelliflow_prod_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_SECURE_PASSWORD!

# Redis Cache Credentials (Upstash / Managed Redis)
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD!

# JWT Token Security (Minimum 32 characters required)
APP_JWT_SECRET=ProductionSuperSecretJwtKeyWithMinimum32BytesLengthRequirementRequired123!
APP_JWT_EXPIRATION_MS=900000

# Groq API & Sentence Transformers Credentials (100% Free Stack)
GROQ_API_KEY=gsk_your_free_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_CHAT=llama-3.3-70b-versatile
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# CORS Policy
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
