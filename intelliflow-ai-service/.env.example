# ===================================================================
# IntelliFlow FastAPI AI Microservice — Environment Template
# ===================================================================

PROJECT_NAME=IntelliFlow AI Service
VERSION=1.0.0
API_V1_STR=/api/v1

# Infrastructure Connections
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_pass@your_db_host:5432/intelliflow_db
REDIS_URL=rediss://default:your_redis_pass@your_redis_host:6379/0

# Groq API & Hugging Face Embedding Credentials (100% Free Stack)
GROQ_API_KEY=gsk_your_free_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_CHAT=llama-3.3-70b-versatile
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
