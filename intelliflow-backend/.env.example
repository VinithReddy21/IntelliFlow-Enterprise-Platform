# ===================================================================
# IntelliFlow Spring Boot Backend — Production Environment Template
# ===================================================================

SPRING_PROFILES_ACTIVE=prod
PORT=8080

# PostgreSQL Datasource Configuration (Neon Postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>:5432/intelliflow_db?sslmode=require
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# Redis Cache Configuration (Upstash Redis)
SPRING_DATA_REDIS_URL=rediss://default:your_redis_password@your-redis-host.upstash.io:6379
SPRING_DATA_REDIS_HOST=your-redis-host.upstash.io
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=your_redis_password
SPRING_DATA_REDIS_SSL=true

# JWT Token Security (Minimum 32 characters / 256-bit entropy required)
JWT_SECRET=YourSuperSecretProductionJwtSigningKeyWithMinimum32BytesEntropyLength!
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Whitelisted Origins (Comma-separated)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Free AI Stack Credentials (Groq + SentenceTransformers)
GROQ_API_KEY=gsk_your_free_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_CHAT=llama-3.3-70b-versatile
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Downstream Microservices
AI_SERVICE_BASE_URL=https://intelliflow-ai-service.onrender.com
